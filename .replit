# Replit deployment config — bypasses Replit's auto package detection (upm) which crashes on this repo.
run = ["sh", "-c", "uv run uvicorn core.server:app --host 0.0.0.0 --port ${PORT:-8000}"]
modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pip install uv && uv sync --frozen && (cd frontend && npm ci && npm run build) && rm -rf static && cp -r frontend/out static"]
run = ["sh", "-c", "uv run uvicorn core.server:app --host 0.0.0.0 --port ${PORT:-8000}"]

[env]
ENVIRONMENT = "production"
UV_LINK_MODE = "copy"
