# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT=development                # development | production | test
# Public HTTPS origin Vapi can reach. Local dev: your tunnel URL. Render injects RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4-compatible), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Local/offline development and tests use SQLite:
DATABASE_URL=sqlite:///./data/dev.db
SEED_DEMO_DATA=true                    # 2 fake patients + demo login when tables are empty

# ---- Dashboard auth ---------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
ALLOW_SIGNUP=true

# ---- Voice loop placement -----------------------------------------------------
VOICE_LLM_MODE=vapi                    # vapi = Vapi runs the LLM (OpenRouter provider) + calls our tools; custom = our LangChain loop
VAPI_MODEL_PROVIDER=openrouter         # provider Vapi uses in vapi mode (openai = Vapi-billed GPT-4o fallback)
VAPI_MODEL=                            # model id for vapi mode; defaults to LLM_MODEL

# ---- LLM: LangChain -> OpenRouter (analysis, Q&A, custom loop) ----------------
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low               # gpt-oss reasoning effort; low keeps voice latency down
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=350
LLM_PROVIDER_ORDER=Cerebras,Groq       # OpenRouter provider preference (fast first); blank = default routing
ANALYSIS_MODEL=                        # post-call analysis model; defaults to LLM_MODEL

# ---- Vapi (telephony / STT / TTS) -------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=change-me-shared-secret   # sent by Vapi as Bearer token / x-vapi-secret
VAPI_ASSISTANT_NAME=Patient Registration Agent
VAPI_ASSISTANT_ID=                     # optional: pin an existing assistant
VAPI_PHONE_NUMBER_ID=                  # optional: attach an existing Vapi number
VAPI_AREA_CODE=415                     # used when the setup script creates a free number
VAPI_SYNC_ON_STARTUP=false             # true on Render: re-point the assistant at RENDER_EXTERNAL_URL on boot
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot

# ---- Persona ----------------------------------------------------------------
CLINIC_NAME=Maple Health Clinic
AGENT_NAME=Sam
